{
  "name": "@magi-linear-axi/linear-benchmark",
  "version": "0.1.0",
  "private": true,
  "description": "Non-destructive read-only benchmark harness for magi-linear-axi and Linear MCP",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
